<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="com.floreantpos.model">
	<class lazy="false" name="com.floreantpos.model.Server" table="SERVERS">
		<id column="AUTO_ID" name="id" type="java.lang.Integer">
			<generator class="identity"/>
		</id>
		<property column="FIRST_NAME" length="60" name="firstName" not-null="true" type="string"/>
		<property column="LAST_NAME" length="60" name="lastName" not-null="true" type="string"/>
		<property column="NICKNAME" length="60" name="nickname" type="string"/>
		<property column="PHONE" length="30" name="phone" type="string"/>
		<property column="ACTIVE" name="active" type="java.lang.Boolean"/>
	</class>
</hibernate-mapping>
